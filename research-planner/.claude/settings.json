{
  "extraKnownMarketplaces": {
    "gptaku-plugins": {
      "source": {
        "source": "github",
        "repo": "fivetaku/gptaku_plugins"
      }
    }
  },
  "enabledPlugins": {
    "docs-guide@gptaku-plugins": true,
    "insane-research@gptaku-plugins": true,
    "insane-search@gptaku-plugins": true,
    "show-me-the-prd@gptaku-plugins": true,
    "skillers-suda@gptaku-plugins": true,
    "kkirikkiri@gptaku-plugins": true,
    "gptaku-core@gptaku-plugins": true
  },
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ],
    "allow": [
      "Edit(./90-log/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_tool.py"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_tool.py"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_end_queue.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
